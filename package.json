{
  "name": "french-coach",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsx --tsconfig tsconfig.scripts.json scripts/seo/prerender.ts && tsx --tsconfig tsconfig.scripts.json scripts/seo/sitemap.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "build:server": "esbuild server/index.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/server.js",
    "start:server": "node dist/server.js",
    "seed:content": "tsx scripts/seed-content.ts",
    "authoring:skeleton": "tsx scripts/authoring/skeleton.ts",
    "authoring:check": "tsx scripts/authoring/check.ts",
    "authoring:review-sheet": "tsx scripts/authoring/reviewSheet.ts",
    "authoring:status": "tsx scripts/authoring/status.ts",
    "learn:skeleton": "tsx scripts/authoring/learnSkeleton.ts",
    "learn:infer": "tsx scripts/authoring/inferLearnDemands.ts",
    "learn:build-manifest": "tsx scripts/authoring/buildDemandsManifest.ts",
    "learn:sync-backend": "tsx scripts/authoring/syncLearnDemandsToBackend.ts",
    "learn:check": "tsx scripts/authoring/checkLearnDemands.ts",
    "learn:review": "tsx scripts/authoring/learnReview.ts",
    "learn:status": "tsx scripts/authoring/learnStatus.ts",
    "stt:ingest": "tsx scripts/stt/ingestSession.ts",
    "score:batch": "tsx scripts/scoring/batchScore.ts",
    "score:golden": "tsx scripts/scoring/goldenRegression.ts",
    "score:inspect": "tsx scripts/scoring/inspectAttempt.ts",
    "score:review": "tsx scripts/scoring/reviewAttempt.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "@sentry/react": "^10.62.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@supabase/supabase-js": "^2.57.4",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "groq-sdk": "^1.3.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "esbuild": "^0.21.5",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^4.1.8"
  }
}
