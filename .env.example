VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Sentry (React project's DSN). Errors are sent only from production builds with this set.
# Source-map upload also needs SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT at build time
# (Vercel); the release is VERCEL_GIT_COMMIT_SHA automatically.
VITE_SENTRY_DSN=
VITE_SITE_URL=https://french.beyondthebasics.me
# Render Node scoring service (server/index.ts) — must be HTTPS in production or the
# browser blocks it as mixed content. Empty/unset means ExamMode shows no marks.
VITE_SCORING_API_URL=
# Exam pronunciation analysis (feedback only, never a mark). Its UI is admin-only until the
# calibration passes; set to 1 to show it to everyone. The backend's EXAM_PRONUNCIATION_ACCESS
# (off | admin | all) stays authoritative either way.
VITE_EXAM_PRONUNCIATION_PUBLIC=
# Exam answers are marked from each recording's Whisper transcript (the live captions are the fallback).
# Set to 0 to mark from the live captions only, as before. Unset = on.
VITE_EXAM_BATCH_ASR=

# server/index.ts (scoring service) — Node-side, not exposed to the browser
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
GEMINI_API_KEY=
GROQ_API_KEY=
CORS_ORIGINS=
SCORING_DEBUG=
# Sentry (Node project's DSN). Unset = off. Release = RENDER_GIT_COMMIT (set by Render).
SENTRY_DSN=
