VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SENTRY_DSN=
VITE_SITE_URL=https://french.beyondthebasics.me
# Render Node scoring service (server/index.ts) — must be HTTPS in production or the
# browser blocks it as mixed content. Empty/unset means ExamMode shows no marks.
VITE_SCORING_API_URL=
# Exam pronunciation analysis (feedback only, never a mark). Its UI is admin-only until the
# calibration passes; set to 1 to show it to everyone. The backend's EXAM_PRONUNCIATION_ACCESS
# (off | admin | all) stays authoritative either way.
VITE_EXAM_PRONUNCIATION_PUBLIC=

# server/index.ts (scoring service) — Node-side, not exposed to the browser
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
GEMINI_API_KEY=
GROQ_API_KEY=
CORS_ORIGINS=
SCORING_DEBUG=
